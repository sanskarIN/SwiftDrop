<Project>
  <Import Project="../../Directory.Build.props" />
  <PropertyGroup>
    <!-- MAUI platform SDKs can surface target-version/obsolete compatibility warnings that differ by installed workload.
         Keep portable Core warnings strict while still failing App builds on common nullable-safety regressions. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
  </PropertyGroup>
</Project>
