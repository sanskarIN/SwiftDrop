<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SwiftDrop.App.DevicesPage"
             Title="Nearby devices">
  <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="14">
    <VerticalStackLayout Grid.Row="0" Spacing="8">
      <Label Text="Nearby devices" FontSize="28" FontAttributes="Bold" />
      <Label Text="SwiftDrop discovers peers through mDNS/Bonjour with UDP fallback. Devices expire automatically when they stop announcing." FontSize="13" Opacity="0.75" />
      <HorizontalStackLayout Spacing="10">
        <Button Text="Refresh" Clicked="RefreshClicked" />
        <Label x:Name="StatusLabel" VerticalTextAlignment="Center" />
      </HorizontalStackLayout>
    </VerticalStackLayout>

    <CollectionView Grid.Row="1" x:Name="DevicesList" EmptyView="No nearby devices found yet. QR or pasted invitations remain available.">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
              <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
              <Label Grid.Row="0" Grid.Column="1" Text="{Binding Platform}" FontSize="12" Opacity="0.7" />
              <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AddressText}" FontSize="12" Opacity="0.75" />
              <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LastSeenText}" FontSize="11" Opacity="0.6" />
              <Button Grid.Row="3" Grid.ColumnSpan="2" Text="Request pairing" CommandParameter="{Binding Id}" Clicked="PairClicked" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
