<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.DevicesPage"
             Title="{services:Localize NearbyDevices}">
  <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="14">
    <VerticalStackLayout Grid.Row="0" Spacing="8">
      <Label Text="{services:Localize NearbyDevices}" FontSize="28" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{services:Localize NearbyDescription}" FontSize="13" Opacity="0.75" />
      <HorizontalStackLayout Spacing="10">
        <Button Text="{services:Localize Refresh}" Clicked="RefreshClicked" />
        <Label x:Name="StatusLabel" VerticalTextAlignment="Center" />
      </HorizontalStackLayout>
    </VerticalStackLayout>

    <Border Grid.Row="1" StrokeShape="RoundRectangle 16" Padding="14">
      <VerticalStackLayout Spacing="8">
        <Label Text="{services:Localize ManualIpFallback}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{services:Localize ManualIpDescription}" FontSize="12" Opacity="0.75" />
        <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="8">
          <Entry x:Name="ManualIpEntry" Grid.Column="0" Placeholder="192.168.1.20" Keyboard="Url" />
          <Entry x:Name="ManualPortEntry" Grid.Column="1" Placeholder="47821" Keyboard="Numeric" MaxLength="5" WidthRequest="90" />
          <Entry x:Name="ManualCodeEntry" Grid.Column="2" Placeholder="{services:Localize EightDigitCode}" Keyboard="Numeric" MaxLength="8" WidthRequest="130" IsPassword="True" />
        </Grid>
        <Button Text="{services:Localize PairByIpCode}" Clicked="ManualPairClicked" />
      </VerticalStackLayout>
    </Border>

    <CollectionView Grid.Row="2" x:Name="DevicesList" EmptyView="{services:Localize NearbyEmpty}">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
              <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="17" />
              <Label Grid.Row="0" Grid.Column="1" Text="{Binding Platform}" FontSize="12" Opacity="0.7" />
              <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AddressText}" FontSize="12" Opacity="0.75" />
              <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LastSeenText}" FontSize="11" Opacity="0.6" />
              <Button Grid.Row="3" Grid.ColumnSpan="2" Text="{services:Localize RequestPairing}" CommandParameter="{Binding Id}" Clicked="PairClicked" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
