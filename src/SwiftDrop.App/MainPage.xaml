<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.MainPage"
             Title="SwiftDrop">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="16">
      <VerticalStackLayout Spacing="4">
        <Label Text="SwiftDrop" FontSize="34" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
        <Label Text="{services:Localize Tagline}" FontSize="14" Opacity="0.72" />
      </VerticalStackLayout>

      <Border StrokeShape="RoundRectangle 18" Padding="14">
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="10" ColumnSpacing="10">
          <Button Grid.Row="0" Grid.Column="0" Text="{services:Localize TransferQueue}" Clicked="OpenQueueClicked" />
          <Button Grid.Row="0" Grid.Column="1" Text="{services:Localize TransferHistory}" Clicked="OpenHistoryClicked" />
          <Button Grid.Row="1" Grid.Column="0" Text="{services:Localize Settings}" Clicked="OpenSettingsClicked" />
          <Button Grid.Row="1" Grid.Column="1" Text="{services:Localize About}" Clicked="OpenAboutClicked" />
        </Grid>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{services:Localize ThisDevice}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{Binding DeviceName}" FontSize="18" />
          <Label Text="{Binding DeviceId}" FontSize="12" Opacity="0.7" />
          <Label Text="{Binding DeviceFingerprint}" FontSize="12" LineBreakMode="CharacterWrap" />
          <Label Text="{Binding ReceiveFolder}" FontSize="12" Opacity="0.75" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize PairThisDevice}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize CreatePairing}" Clicked="CreatePairingClicked" />
            <Button Text="{services:Localize CreateEightDigitCode}" Clicked="CreatePairingCodeClicked" />
          </HorizontalStackLayout>
          <Entry x:Name="PairingLinkEntry" IsReadOnly="True" Placeholder="{services:Localize PairingLinkPlaceholder}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize CopyLink}" Clicked="CopyLinkClicked" />
            <Button Text="{services:Localize ShareLink}" Clicked="ShareLinkClicked" />
          </HorizontalStackLayout>
          <Label x:Name="PairingCodeLabel" FontSize="26" FontAttributes="Bold" IsVisible="False" />
          <Label x:Name="PairingCodeExpiryLabel" FontSize="12" IsVisible="False" />
          <Image x:Name="QrImage" HeightRequest="220" WidthRequest="220" IsVisible="False" SemanticProperties.Description="{services:Localize PairingQrCodeDescription}" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize ConnectToAnotherDevice}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Entry x:Name="RemoteLinkEntry" Placeholder="{services:Localize PastePairingLink}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize VerifyPairing}" Clicked="ValidatePairingClicked" />
            <Button Text="{services:Localize NearbyDevices}" Clicked="OpenDevicesClicked" />
          </HorizontalStackLayout>
          <Label Text="{Binding RemotePeer}" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize SendOneFile}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Button Text="{services:Localize ChooseFile}" Clicked="ChooseFileClicked" />
          <Label Text="{Binding SelectedFile}" FontSize="12" LineBreakMode="MiddleTruncation" />
          <ProgressBar Progress="{Binding TransferProgress}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize Send}" Clicked="SendFileClicked" IsEnabled="{Binding SendFileEnabled}" />
            <Button Text="{services:Localize Pause}" Clicked="PauseSendClicked" IsEnabled="{Binding PauseSendEnabled}" />
            <Button Text="{services:Localize Resume}" Clicked="ResumeSendClicked" IsEnabled="{Binding ResumeSendEnabled}" />
            <Button Text="{services:Localize Cancel}" Clicked="CancelSendClicked" IsEnabled="{Binding CancelSendEnabled}" />
          </HorizontalStackLayout>
          <Label Text="{Binding TransferStatus}" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize SendMultipleOrFolder}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize ChooseFiles}" Clicked="ChooseMultipleFilesClicked" />
            <Button Text="{services:Localize ChooseFolder}" Clicked="ChooseFolderClicked" />
          </HorizontalStackLayout>
          <Label Text="{Binding SelectedBatch}" FontSize="12" LineBreakMode="MiddleTruncation" />
          <ProgressBar Progress="{Binding BatchTransferProgress}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize SendSelectedItems}" Clicked="SendBatchStableClicked" IsEnabled="{Binding SendBatchEnabled}" />
            <Button Text="{services:Localize Pause}" Clicked="PauseBatchStableClicked" IsEnabled="{Binding PauseBatchEnabled}" />
            <Button Text="{services:Localize Resume}" Clicked="ResumeBatchStableClicked" IsEnabled="{Binding ResumeBatchEnabled}" />
            <Button Text="{services:Localize Cancel}" Clicked="CancelBatchStableClicked" IsEnabled="{Binding CancelBatchEnabled}" />
          </HorizontalStackLayout>
          <Label Text="{Binding BatchTransferStatus}" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize SendText}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize ClipboardPrivacyNote}" FontSize="12" Opacity="0.7" />
          <Editor x:Name="TextSnippetEditor" Placeholder="{services:Localize TextSnippetPlaceholder}" AutoSize="TextChanges" MaximumHeightRequest="180" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize PasteFromClipboard}" Clicked="PasteClipboardClicked" />
            <Button Text="{services:Localize SendText}" Clicked="SendTextClicked" />
          </HorizontalStackLayout>
          <Label Text="{Binding TextTransferStatus}" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{services:Localize ConnectionHelp}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize ConnectionHelpDescription}" FontSize="13" Opacity="0.75" />
          <Button Text="{services:Localize OpenLocalDiagnostics}" Clicked="OpenDiagnosticsClicked" />
        </VerticalStackLayout>
      </Border>

      <Label Text="{services:Localize MadeBy}" HorizontalTextAlignment="Center" FontSize="12" Opacity="0.6" Margin="0,12" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
