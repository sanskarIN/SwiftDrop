<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.MainPage"
             Title="{services:Localize AppName}">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="4">
          <Label Text="{services:Localize AppName}" FontSize="34" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
          <Label Text="{services:Localize Tagline}" FontSize="16" Opacity="0.75" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
          <Button Text="{services:Localize Devices}" Clicked="OpenDevicesClicked" SemanticProperties.Description="{services:Localize OpenNearbyDevicesDescription}" />
          <Button Text="{services:Localize Queue}" Clicked="OpenQueueClicked" SemanticProperties.Description="{services:Localize OpenTransferQueueDescription}" />
          <Button Text="{services:Localize History}" Clicked="OpenHistoryClicked" SemanticProperties.Description="{services:Localize OpenTransferHistoryDescription}" />
          <Button Text="{services:Localize Settings}" Clicked="OpenSettingsClicked" SemanticProperties.Description="{services:Localize OpenSettingsDescription}" />
        </HorizontalStackLayout>
      </Grid>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize ThisDevice}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{Binding DeviceName}" />
          <Label Text="{Binding DeviceId}" FontSize="12" Opacity="0.65" LineBreakMode="TailTruncation" />
          <Label Text="{Binding DeviceFingerprint}" FontSize="11" Opacity="0.7" LineBreakMode="CharacterWrap" />
          <Label Text="{Binding ReceiveFolder}" FontSize="11" Opacity="0.7" LineBreakMode="MiddleTruncation" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize CreateQrLink}" Clicked="CreatePairingClicked" SemanticProperties.Description="{services:Localize CreateQrLinkDescription}" />
            <Button Text="{services:Localize CreateEightDigitCode}" Clicked="CreatePairingCodeClicked" SemanticProperties.Description="{services:Localize CreateEightDigitCodeDescription}" />
          </HorizontalStackLayout>
          <Label x:Name="PairingCodeLabel" FontSize="22" FontAttributes="Bold" IsVisible="False" SemanticProperties.Description="{services:Localize PairingCodeDescription}" />
          <Label x:Name="PairingCodeExpiryLabel" FontSize="12" Opacity="0.7" IsVisible="False" />
          <Image x:Name="QrImage" HeightRequest="240" WidthRequest="240" IsVisible="False" SemanticProperties.Description="{services:Localize PairingQrDescription}" />
          <Entry x:Name="PairingLinkEntry" Placeholder="{services:Localize PairingLinkPlaceholder}" IsReadOnly="True" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize CopyLink}" Clicked="CopyLinkClicked" />
            <Button Text="{services:Localize ShareLink}" Clicked="ShareLinkClicked" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize ConnectToDevice}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Entry x:Name="RemoteLinkEntry" Placeholder="{services:Localize PastePairingLinkPlaceholder}" />
          <Button Text="{services:Localize ValidatePairingLink}" Clicked="ValidatePairingClicked" />
          <Label Text="{Binding RemotePeer}" />
          <Label Text="{services:Localize FingerprintSafetyNote}" FontSize="12" Opacity="0.7" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize SendOneFile}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Button Text="{services:Localize ChooseFile}" Clicked="ChooseFileClicked" />
          <Label Text="{Binding SelectedFile}" LineBreakMode="MiddleTruncation" />
          <ProgressBar Progress="{Binding TransferProgress}" SemanticProperties.Description="{services:Localize SingleTransferProgressDescription}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize SendSelectedFile}" Clicked="SendFileClicked" IsEnabled="{Binding SendFileEnabled}" />
            <Button Text="{services:Localize Pause}" Clicked="PauseSendClicked" IsEnabled="{Binding PauseSendEnabled}" />
            <Button Text="{services:Localize Resume}" Clicked="ResumeSendClicked" IsEnabled="{Binding ResumeSendEnabled}" />
            <Button Text="{services:Localize Cancel}" Clicked="CancelSendClicked" IsEnabled="{Binding CancelSendEnabled}" />
          </HorizontalStackLayout>
          <Label Text="{Binding TransferStatus}" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize SendMultipleOrFolder}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize BatchSelectionDescription}" FontSize="12" Opacity="0.75" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize ChooseMultipleFiles}" Clicked="ChooseMultipleFilesClicked" />
            <Button Text="{services:Localize ChooseFolder}" Clicked="ChooseFolderClicked" />
          </HorizontalStackLayout>
          <Label Text="{Binding SelectedBatch}" LineBreakMode="TailTruncation" />
          <ProgressBar Progress="{Binding BatchTransferProgress}" SemanticProperties.Description="{services:Localize BatchProgressDescription}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize SendSelectedItems}" Clicked="SendBatchClicked" IsEnabled="{Binding SendBatchEnabled}" />
            <Button Text="{services:Localize Pause}" Clicked="PauseBatchClicked" IsEnabled="{Binding PauseBatchEnabled}" />
            <Button Text="{services:Localize Resume}" Clicked="ResumeBatchClicked" IsEnabled="{Binding ResumeBatchEnabled}" />
            <Button Text="{services:Localize Cancel}" Clicked="CancelBatchClicked" IsEnabled="{Binding CancelBatchEnabled}" />
          </HorizontalStackLayout>
          <Label Text="{Binding BatchTransferStatus}" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize SendText}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize ClipboardPrivacyNote}" FontSize="12" Opacity="0.7" />
          <Editor x:Name="TextSnippetEditor" Placeholder="{services:Localize TextSnippetPlaceholder}" AutoSize="TextChanges" MaximumHeightRequest="180" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize PasteFromClipboard}" Clicked="PasteClipboardClicked" />
            <Button Text="{services:Localize SendText}" Clicked="SendTextClicked" />
          </HorizontalStackLayout>
          <Label Text="{Binding TextTransferStatus}" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{services:Localize ConnectionHelp}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize ConnectionHelpDescription}" FontSize="13" Opacity="0.75" />
          <Button Text="{services:Localize OpenLocalDiagnostics}" Clicked="OpenDiagnosticsClicked" />
        </VerticalStackLayout>
      </Border>

      <Label Text="{services:Localize MadeBy}" HorizontalTextAlignment="Center" FontSize="12" Opacity="0.6" Margin="0,12" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
