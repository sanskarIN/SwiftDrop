<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="SwiftDrop.App.MainPage" Title="SwiftDrop">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <VerticalStackLayout Grid.Column="0" Spacing="4">
          <Label Text="SwiftDrop" FontSize="34" FontAttributes="Bold" />
          <Label Text="Fast, private local transfers — no account required." FontSize="16" Opacity="0.75" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
          <Button Text="Devices" Clicked="OpenDevicesClicked" />
          <Button Text="History" Clicked="OpenHistoryClicked" />
          <Button Text="Settings" Clicked="OpenSettingsClicked" />
        </HorizontalStackLayout>
      </Grid>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="This device" FontAttributes="Bold" FontSize="18" />
          <Label x:Name="DeviceNameLabel" />
          <Label x:Name="DeviceIdLabel" FontSize="12" Opacity="0.65" LineBreakMode="TailTruncation" />
          <Button Text="Create pairing link" Clicked="CreatePairingClicked" />
          <Image x:Name="QrImage" HeightRequest="240" WidthRequest="240" IsVisible="False" />
          <Entry x:Name="PairingLinkEntry" Placeholder="Pairing link appears here" IsReadOnly="True" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="Copy link" Clicked="CopyLinkClicked" />
            <Button Text="Share link" Clicked="ShareLinkClicked" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="Connect to a device" FontAttributes="Bold" FontSize="18" />
          <Entry x:Name="RemoteLinkEntry" Placeholder="Paste swiftdrop:// pairing link" />
          <Button Text="Validate pairing link" Clicked="ValidatePairingClicked" />
          <Label x:Name="RemotePeerLabel" />
          <Label Text="Always compare the certificate fingerprint with the receiving device before sending sensitive files." FontSize="12" Opacity="0.7" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="Send file" FontAttributes="Bold" FontSize="18" />
          <Button Text="Choose file" Clicked="ChooseFileClicked" />
          <Label x:Name="SelectedFileLabel" LineBreakMode="MiddleTruncation" />
          <ProgressBar x:Name="TransferProgress" Progress="0" />
          <HorizontalStackLayout Spacing="10">
            <Button x:Name="SendFileButton" Text="Send selected file" Clicked="SendFileClicked" />
            <Button x:Name="CancelSendButton" Text="Cancel" Clicked="CancelSendClicked" IsEnabled="False" />
          </HorizontalStackLayout>
          <Label x:Name="TransferStatusLabel" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="Send text" FontAttributes="Bold" FontSize="18" />
          <Label Text="SwiftDrop reads the clipboard only when you press Paste from clipboard. It never monitors the clipboard in the background." FontSize="12" Opacity="0.7" />
          <Editor x:Name="TextSnippetEditor" Placeholder="Type or paste a short text snippet" AutoSize="TextChanges" MaximumHeightRequest="180" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="Paste from clipboard" Clicked="PasteClipboardClicked" />
            <Button Text="Send text" Clicked="SendTextClicked" />
          </HorizontalStackLayout>
          <Label x:Name="TextTransferStatusLabel" FontSize="12" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="Connection help" FontAttributes="Bold" FontSize="18" />
          <Label Text="If nearby devices cannot connect, run a local diagnostic. Guest Wi-Fi, client isolation, local-network permissions, and firewalls may block peer-to-peer traffic." FontSize="13" Opacity="0.75" />
          <Button Text="Open local network diagnostics" Clicked="OpenDiagnosticsClicked" />
        </VerticalStackLayout>
      </Border>

      <Label Text="Made by the Sanskar" HorizontalTextAlignment="Center" FontSize="12" Opacity="0.6" Margin="0,12" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
