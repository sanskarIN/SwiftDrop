<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.DiagnosticsPage"
             Title="{services:Localize Diagnostics}">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20" RowSpacing="14">
    <VerticalStackLayout Grid.Row="0" Spacing="6">
      <Label Text="{services:Localize LocalNetworkDiagnostics}" FontSize="28" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{services:Localize DiagnosticsPrivacyDescription}" FontSize="13" Opacity="0.75" />
    </VerticalStackLayout>

    <Border Grid.Row="1" StrokeShape="RoundRectangle 16" Padding="14">
      <VerticalStackLayout Spacing="6">
        <Label Text="{services:Localize DeveloperStatus}" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding ProtocolStatus}" />
        <Label Text="{Binding MdnsStatus}" />
        <Label Text="{Binding UdpStatus}" />
        <Label Text="{services:Localize QrFallbackNote}" FontSize="12" />
        <HorizontalStackLayout Spacing="10">
          <Button Text="{services:Localize RefreshDiagnostics}" Clicked="RefreshClicked" />
          <Button Text="{services:Localize ExportSafeLog}" Clicked="ExportClicked" />
          <Button Text="{services:Localize ClearLog}" Clicked="ClearLogClicked" />
        </HorizontalStackLayout>
      </VerticalStackLayout>
    </Border>

    <Border Grid.Row="2" StrokeShape="RoundRectangle 16" Padding="14" IsVisible="{Binding DeveloperOptionsEnabled}">
      <VerticalStackLayout Spacing="8">
        <Label Text="{services:Localize SafeDeveloperSelfTests}" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{services:Localize SelfTestDescription}" FontSize="12" Opacity="0.75" />
        <HorizontalStackLayout Spacing="10">
          <Button Text="{services:Localize GoodRoundTrip}" Clicked="RunRoundTripTestClicked" />
          <Button Text="{services:Localize ChecksumMismatch}" Clicked="RunChecksumTestClicked" />
          <Button Text="{services:Localize InterruptedReceive}" Clicked="RunInterruptionTestClicked" />
        </HorizontalStackLayout>
        <Label Text="{Binding SelfTestResult}" FontSize="12" />
      </VerticalStackLayout>
    </Border>

    <CollectionView Grid.Row="3" ItemsSource="{Binding Diagnostics}" HeightRequest="220" EmptyView="{services:Localize DiagnosticsEmpty}">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,10">
            <VerticalStackLayout Spacing="5">
              <Label Text="{Binding Title}" FontAttributes="Bold" />
              <Label Text="{Binding Message}" FontSize="13" />
              <Label Text="{Binding Severity}" FontSize="11" Opacity="0.65" />
            </VerticalStackLayout>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <CollectionView Grid.Row="4" ItemsSource="{Binding Events}" EmptyView="{services:Localize PersistedEventsEmpty}">
      <CollectionView.Header>
        <Label Text="{services:Localize RecentSafeDiagnosticEvents}" FontSize="18" FontAttributes="Bold" Margin="0,6" SemanticProperties.HeadingLevel="Level2" />
      </CollectionView.Header>
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border StrokeShape="RoundRectangle 14" Padding="12" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Label Text="{Binding Level}" FontAttributes="Bold" />
              <Label Grid.Column="1" Text="{Binding Code}" />
              <Label Grid.Column="2" Text="{Binding TimestampUtc, StringFormat='{0:g}'}" FontSize="11" Opacity="0.7" />
              <Label Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Message}" FontSize="12" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </Grid>
</ContentPage>
