<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.SettingsPage"
             Title="{services:Localize Settings}">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Label Text="{services:Localize SwiftDropSettings}" FontSize="30" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{services:Localize SettingsSummary}" Opacity="0.75" />

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize DeviceIdentity}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize DeviceName}" />
          <Entry Text="{Binding DeviceName, Mode=TwoWay}" MaxLength="64" Placeholder="{services:Localize SwiftDropDevicePlaceholder}" />
          <Label Text="{Binding IdentityFingerprint}" FontSize="11" Opacity="0.7" LineBreakMode="CharacterWrap" />
          <Button Text="{services:Localize ResetDeviceIdentity}" Clicked="ResetIdentityClicked" />
          <Label Text="{services:Localize ResetIdentityDescription}" FontSize="12" Opacity="0.7" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize Transfers}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{services:Localize DefaultReceiveFolder}" />
          <Entry Text="{Binding ReceiveFolder}" IsReadOnly="True" LineBreakMode="MiddleTruncation" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="{services:Localize ChooseFolder}" Clicked="ChooseReceiveFolderClicked" />
            <Button Text="{services:Localize UseAppFolder}" Clicked="UseAppReceiveFolderClicked" />
          </HorizontalStackLayout>
          <Label Text="{Binding ReceiveFolderSupport}" FontSize="12" Opacity="0.7" />
          <Label Text="{services:Localize ConcurrentTransfers}" />
          <Stepper Value="{Binding TransferConcurrency, Mode=TwoWay}" Minimum="1" Maximum="8" Increment="1" ValueChanged="NumericSettingChanged" />
          <Label Text="{Binding ConcurrencyText}" />
          <Label Text="{services:Localize HistoryRetentionDays}" />
          <Stepper Value="{Binding HistoryRetentionDays, Mode=TwoWay}" Minimum="0" Maximum="3650" Increment="1" ValueChanged="NumericSettingChanged" />
          <Label Text="{Binding RetentionText}" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize PrivacyAndTrust}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
          <HorizontalStackLayout Spacing="12">
            <Switch IsToggled="{Binding PrivacyMode, Mode=TwoWay}" />
            <Label Text="{services:Localize HideFilenamesHistory}" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <HorizontalStackLayout Spacing="12">
            <Switch IsToggled="{Binding AutoAcceptTrustedDevices, Mode=TwoWay}" />
            <Label Text="{services:Localize AutoAcceptTrusted}" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <Button Text="{services:Localize ManageTrustedDevices}" Clicked="ManageTrustedDevicesClicked" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize NotificationsAndAccessibility}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
          <HorizontalStackLayout Spacing="12">
            <Switch IsEnabled="{Binding NotificationsSupported}" IsToggled="{Binding NotificationsEnabled, Mode=TwoWay}" />
            <Label Text="{services:Localize OptionalNotifications}" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <Label Text="{Binding NotificationSupport}" FontSize="12" Opacity="0.7" />
          <HorizontalStackLayout Spacing="12">
            <Switch IsToggled="{Binding ReduceMotion, Mode=TwoWay}" />
            <Label Text="{services:Localize ReduceMotion}" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <HorizontalStackLayout Spacing="12">
            <Switch IsToggled="{Binding LargerInterface, Mode=TwoWay}" />
            <Label Text="{services:Localize LargerInterface}" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <Label Text="{services:Localize NotificationRuleNote}" FontSize="12" Opacity="0.7" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize AppearanceAndLanguage}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
          <Picker SelectedItem="{Binding Theme, Mode=TwoWay}" Title="{services:Localize Theme}">
            <Picker.Items>
              <x:String>System</x:String>
              <x:String>Light</x:String>
              <x:String>Dark</x:String>
            </Picker.Items>
          </Picker>
          <Picker SelectedItem="{Binding Language, Mode=TwoWay}" Title="{services:Localize Language}">
            <Picker.Items>
              <x:String>English</x:String>
              <x:String>Hindi</x:String>
            </Picker.Items>
          </Picker>
          <Label Text="{services:Localize LocalizationFallbackNote}" FontSize="12" Opacity="0.7" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="12">
          <Label Text="{services:Localize DeveloperOptions}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2" />
          <HorizontalStackLayout Spacing="12">
            <Switch IsToggled="{Binding DeveloperOptionsEnabled, Mode=TwoWay}" />
            <Label Text="{services:Localize EnableSafeDeveloperDiagnostics}" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <Label Text="{services:Localize DeveloperDiagnosticsNote}" FontSize="12" Opacity="0.7" />
          <Button Text="{services:Localize OpenDiagnostics}" Clicked="OpenDiagnosticsClicked" />
        </VerticalStackLayout>
      </Border>

      <Button Text="{services:Localize SaveSettings}" Clicked="SaveClicked" />
      <Button Text="{services:Localize ResetSettingsDefaults}" Clicked="ResetClicked" />
      <Button Text="{services:Localize About}" Clicked="OpenAboutClicked" />
      <Label Text="{services:Localize MadeBy}" HorizontalTextAlignment="Center" FontSize="12" Opacity="0.6" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
