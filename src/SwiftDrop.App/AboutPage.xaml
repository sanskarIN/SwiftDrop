<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.AboutPage"
             Title="{x:Static services:AppText.About}">
  <ScrollView>
    <VerticalStackLayout Padding="24" Spacing="16">
      <Image Source="appicon.svg" HeightRequest="88" WidthRequest="88" SemanticProperties.Description="{x:Static services:AppText.SwiftDropIconDescription}" />
      <Label Text="{x:Static services:AppText.AppName}" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level1" />
      <Label x:Name="VersionLabel" HorizontalTextAlignment="Center" Opacity="0.75" />
      <Label Text="{x:Static services:AppText.AboutSummary}" HorizontalTextAlignment="Center" />

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{x:Static services:AppText.OpenSource}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{x:Static services:AppText.RepositoryLabel}" />
          <Label Text="{x:Static services:AppText.CreatorLabel}" />
          <Label Text="{x:Static services:AppText.LicenseLabel}" />
          <Button Text="{x:Static services:AppText.OpenRepository}" Clicked="OpenRepositoryClicked" SemanticProperties.Description="{x:Static services:AppText.OpenRepositoryDescription}" />
          <Button Text="{x:Static services:AppText.OpenCreatorProfile}" Clicked="OpenProfileClicked" SemanticProperties.Description="{x:Static services:AppText.OpenCreatorProfileDescription}" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{x:Static services:AppText.SupportDevelopment}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{x:Static services:AppText.SupportDevelopmentDescription}" />
          <Label Text="https://buymeacoffee.com/sanskarIN" FontSize="13" />
          <Button Text="{x:Static services:AppText.BuyMeACoffee}" Clicked="OpenBuyMeACoffeeClicked" SemanticProperties.Description="{x:Static services:AppText.BuyMeACoffeeDescription}" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{x:Static services:AppText.ContactAndSecurity}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{x:Static services:AppText.BusinessLabel}" />
          <Label Text="{x:Static services:AppText.SupportLabel}" />
          <Label Text="{x:Static services:AppText.SecurityReportNotice}" />
        </VerticalStackLayout>
      </Border>

      <Border StrokeShape="RoundRectangle 18" Padding="18">
        <VerticalStackLayout Spacing="10">
          <Label Text="{x:Static services:AppText.Privacy}" FontAttributes="Bold" FontSize="18" SemanticProperties.HeadingLevel="Level2" />
          <Label Text="{x:Static services:AppText.PrivacySummary}" />
        </VerticalStackLayout>
      </Border>

      <Label Text="{x:Static services:AppText.MadeBy}" HorizontalTextAlignment="Center" FontAttributes="Bold" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
