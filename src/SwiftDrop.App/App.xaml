<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SwiftDrop.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="Primary">#4F46E5</Color>
      <Color x:Key="Surface">#111827</Color>
      <x:Double x:Key="BodyFontSize">14</x:Double>
      <x:Double x:Key="ControlFontSize">14</x:Double>
      <x:Double x:Key="ControlMinimumHeight">44</x:Double>

      <Style TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
      </Style>
      <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ControlMinimumHeight}" />
      </Style>
      <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ControlMinimumHeight}" />
      </Style>
      <Style TargetType="Editor">
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
      </Style>
      <Style TargetType="Picker">
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{DynamicResource ControlMinimumHeight}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
