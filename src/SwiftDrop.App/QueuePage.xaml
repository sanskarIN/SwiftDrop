<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:SwiftDrop.App.Services"
             x:Class="SwiftDrop.App.QueuePage"
             Title="{x:Static services:AppText.TransferQueue}">
  <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="14">
    <VerticalStackLayout Grid.Row="0" Spacing="6">
      <Label Text="{x:Static services:AppText.TransferQueue}" FontSize="28" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level1" />
      <Label Text="{x:Static services:AppText.QueueDescription}" FontSize="13" Opacity="0.75" />
      <Label Text="{Binding Status}" FontSize="12" Opacity="0.7" />
    </VerticalStackLayout>

    <CollectionView Grid.Row="1" ItemsSource="{Binding Items}" EmptyView="{x:Static services:AppText.QueueEmpty}">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Border StrokeShape="RoundRectangle 14" Padding="14" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
              <Label Text="{Binding Label}" FontAttributes="Bold" />
              <Label Grid.Column="1" Text="{Binding State}" />
              <Label Grid.Row="1" Text="{Binding OperationKind}" FontSize="12" Opacity="0.75" />
              <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" Opacity="0.8" HorizontalTextAlignment="End" />
              <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Progress="{Binding ProgressFraction}" />
              <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding TimingText}" FontSize="12" Opacity="0.7" />
              <Label Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding Error}" FontSize="12" LineBreakMode="WordWrap" />
            </Grid>
          </Border>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>

    <HorizontalStackLayout Grid.Row="2" Spacing="10">
      <Button Text="{x:Static services:AppText.Refresh}" Clicked="RefreshClicked" />
      <Button Text="{x:Static services:AppText.ClearFinished}" Clicked="ClearFinishedClicked" />
    </HorizontalStackLayout>
  </Grid>
</ContentPage>
